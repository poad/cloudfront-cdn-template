{
  "name": "cloudfront-cdn-template",
  "version": "0.1.0",
  "bin": "bin/cloudfront-cdn-template.js",
  "type": "module",
  "scripts": {
    "build": "tsc --build --clean",
    "watch": "tsc -w",
    "test": "vitest --run",
    "cdk": "cdk",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "aws-cdk": "^2.1148.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  }
}
